# Build mode driven by the backend itself (uv run uvicorn app.main:app).
#
# app/services/frontend.py runs `npm run build:embedded` on startup whenever the
# sources are newer than the last build, then serves the output at "/". The
# bundle is same-origin by definition (the backend is serving it), so
# VITE_API_URL must be empty — mode files override .env.
#
# Kept separate from .env.production so the backend's build stays correct even
# if .env.production is pointed at some other deployment target.
VITE_API_URL=

# Branding still inherits from .env (loaded in every mode).
