# Production mode — used by `npm run build`.
#
# The build output lands in backend/frontend_dist, which FastAPI serves at "/"
# from the same origin as the API. So API calls must be relative: an empty
# VITE_API_URL overrides the cross-origin value in .env (mode files beat .env).
#
# To deploy the bundle somewhere the API is on a different origin, override it
# at build time — a real env var still wins:
#   VITE_API_URL=https://api.example.com npm run build
VITE_API_URL=

# Branding still inherits from .env (loaded in every mode).
