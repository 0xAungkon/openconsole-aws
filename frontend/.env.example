# No API base URL is configured here, on purpose: the frontend issues
# relative `/api/...` requests so it never depends on the backend's hostname
# or port. In development `vite.config.ts` forwards those to the backend
# (override with AWS_OPENCONSOLE_API if it isn't http://localhost:4567).
#
# Only set this if the API is deployed on a genuinely different origin from
# the frontend, at build time:
#   VITE_API_URL=https://api.example.com npm run build

# Branding shown in the sidebar/header. Badge renders as a chip next to the name.
VITE_BRAND_BADGE=AWS
VITE_BRAND_NAME=OpenConsole
