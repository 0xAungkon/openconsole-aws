# Database. SQLite for dev; use a Postgres URL in production.
DATABASE_URL=sqlite:///./dev.db

# Secret used to sign JWT access tokens (register mode). Use a long random value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me

# Fernet key used to encrypt stored AWS credentials at rest (register mode).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
